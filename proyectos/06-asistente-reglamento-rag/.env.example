# Cualquier API compatible con chat completions (OpenAI, Groq, Together, Ollama...).
# Sin clave, usa --demo: la respuesta es el artículo recuperado, tal cual.
# El archivo .env no se sube al repo.
LLM_API_KEY=
LLM_MODELO=gpt-4.1-mini
# LLM_BASE_URL=http://localhost:11434/v1   # ejemplo con Ollama local

# Modelo de vectores (fastembed, corre local). El de por defecto pesa ~2.2 GB.
# EMBEDDINGS_MODELO=intfloat/multilingual-e5-large
# EMBEDDINGS_MODELO=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2   # ~220 MB, peor en jerga
