/// Cursos del plan de estudios, con el ciclo al que pertenecen.
table Curso
	lineageTag: 7a5a3995-e965-5e9d-b2cd-826d837cd857

	column id_curso
		dataType: int64
		formatString: 0
		isKey
		isHidden
		lineageTag: b8f08271-f574-54f1-97bb-160eabc48134
		summarizeBy: none
		sourceColumn: id_curso

	column curso
		dataType: string
		lineageTag: eb55817e-5bb9-591c-a092-c9bbb66c4f25
		summarizeBy: none
		sourceColumn: curso

	column id_carrera
		dataType: int64
		formatString: 0
		isHidden
